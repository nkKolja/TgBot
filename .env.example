# Telegram bot token (required)
TELEGRAM_BOT_TOKEN=

# ffmpeg/ffprobe/yt-dlp/gallery-dl paths (auto-detected from PATH if not set)
# YTDLP_BIN=/opt/homebrew/bin/yt-dlp
# GALLERY_DL_BIN=/opt/homebrew/bin/gallery-dl
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe

# --- Authentication ---------------------------------------------------------
# yt-dlp does NOT support username/password login for any site this bot handles
# (Instagram, Facebook, X, TikTok, Reddit, LinkedIn, YouTube) — it prints
# "Login with password is not supported for this website" and carries on
# logged out. Private and age-restricted posts need COOKIES.
#
# Export a Netscape-format cookies.txt from a logged-in browser session
# (e.g. the "Get cookies.txt LOCALLY" extension) and point at it:
# INSTAGRAM_COOKIES=/Users/you/.config/tgbot/instagram-cookies.txt
# FACEBOOK_COOKIES=
# TWITTER_COOKIES=
# TIKTOK_COOKIES=
# REDDIT_COOKIES=
# LINKEDIN_COOKIES=
# YOUTUBE_COOKIES=

# Shared cookie jar for any site without its own file above
# COOKIES_FILE=/Users/you/.config/tgbot/cookies.txt

# Or read cookies straight out of a browser profile.
# COOKIES_FROM_BROWSER=firefox

# With nothing above set, a download that hits a login/age wall is automatically
# retried once using cookies from the first browser profile found on disk
# (firefox, chrome, brave, edge, vivaldi, chromium). Set to false to disable.
# COOKIES_AUTO=true

# *_USERNAME / *_PASSWORD are no longer read: yt-dlp cannot use them for any
# of these sites, and passing them exposed the password in `ps` output.

# --- Upload limits ----------------------------------------------------------
# Largest file the Bot API accepts (MB). api.telegram.org caps bots at 50 for
# every type — audio, video and document alike. Raise this only when pointing
# TELEGRAM_API_URL at your own Bot API server, which allows up to 2000.
# MAX_UPLOAD_MB=50

# Self-hosted Bot API server (https://github.com/tdlib/telegram-bot-api)
# TELEGRAM_API_URL=http://localhost:8081

# Download timeout in seconds, across all attempts for one link (default: 60)
# DOWNLOAD_TIMEOUT_SECS=60

# --- Encoding ---------------------------------------------------------------
# Max seconds for a single ffmpeg run (default: 600)
# ENCODE_TIMEOUT_SECS=600
# x264 preset; veryfast suits older Intel Macs (default: veryfast)
# X264_PRESET=veryfast
# ffmpeg jobs allowed at once (default: 1)
# MAX_CONCURRENT_ENCODES=1

# Videos longer than this (in seconds) trigger an audio/video prompt (default: 300 = 5 min)
# LONG_VIDEO_SECS=300

# Log level (optional, default: info)
# RUST_LOG=tgbot=info
